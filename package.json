{
  "name": "ip",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "version": "26.911.1352",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "wrangler deploy",
    "build": "tsc -b && vite build && node scripts/build-worker-assets.mjs",
    "worker:assets": "node scripts/build-worker-assets.mjs",
    "worker:dev": "node scripts/worker-dev.mjs",
    "worker:types": "wrangler types",
    "test": "node scripts/build-worker-assets.mjs && wrangler deploy --dry-run --env='' --outdir .worker-test && node --import ./tests/register-paths.mjs --test tests/*.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write .",
    "prepare": "husky",
    "browser:build": "node scripts/build-browser-diagnostics.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "fingerprintjs2": "2.1.4",
    "gsap": "^3.15.0",
    "jotai": "^3.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "nprogress": "^0.2.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-liquid-glass-svg": "^1.0.5",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.4",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup": "4.63.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "description": "IP diagnostics SPA with Cloudflare Workers",
  "keywords": [
    "react",
    "vite",
    "spa",
    "shadcn-ui",
    "tanstack-query",
    "tanstack-table"
  ],
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
