{
  "compilerOptions": {
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/*"] },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Pinned to the TypeScript 6 values because TypeScript 7 changed these
       defaults. Dropping either line is a deliberate change, not part of a
       version bump. Measured here: with the Table 9 types in place, `strict`
       reports no errors, so turning it on is its own small follow-up. */
    "strict": false,
    "noUncheckedSideEffectImports": false,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
